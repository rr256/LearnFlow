# LearnFlow local configuration template.
#
# Copy to `.env` and adjust for your machine. `.env` is ignored by Git and must
# never contain real secrets that are shared.
#
# Variable naming follows the three categories in ADR-009:
#   1. Core runtime   APP_*, API_*            how the process itself runs
#   2. Capability     <CAPABILITY>_PROVIDER   which adapter fulfils a port,
#                     and capability-level settings
#   3. Vendor         <VENDOR>_<SETTING>      settings for one specific vendor
#
# docs/deployment/environments.md is the authoritative catalogue of every
# LearnFlow configuration variable. Only the variables the backend reads today
# are listed here; database, AI, retrieval, and storage variables are added when
# the code that consumes them exists.

# --- Application -------------------------------------------------------------
# APP_ENV: local | test | staging | production
APP_ENV=local

# APP_LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO

# Timezone a learner record is created with. An IANA zone name, validated at
# startup. The default suits GATE CSE, the learning program LearnFlow ships with.
APP_DEFAULT_TIMEZONE=Asia/Kolkata

# Address `python -m app.main` serves on. Use 0.0.0.0 when serving from a
# container. The `python -m uvicorn app.main:app` form ignores these and uses
# its own --host/--port arguments instead.
API_HOST=127.0.0.1
API_PORT=8000

# --- Database ----------------------------------------------------------------
# DATABASE_URL has no default and the backend will not start without it. This
# value matches the Compose postgres service as published on the host, so it is
# the URL to use for `python -m alembic upgrade head` and for running the
# backend directly. Inside Compose the backend receives its own URL naming the
# `postgres` service; compose.yaml builds it from the POSTGRES_* values below.
DATABASE_URL=postgresql+psycopg://learnflow:learnflow@127.0.0.1:5432/learnflow

# Credentials the Compose postgres service is created with. These are local
# development values, not secrets to protect; never reuse them anywhere real.
POSTGRES_DB=learnflow
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow

# --- Test harness (optional) --------------------------------------------------
# Read by the test suite, not by the application. Set it to a disposable
# database to run the migration and schema tests in backend/tests/integration/;
# they skip when it is unset. It must never point at the database above, which
# holds real learner data.
#
#   TEST_DATABASE_URL=postgresql+psycopg://learnflow:learnflow@127.0.0.1:5432/learnflow_test
