# ---------------------------------------------------------------------------
# LearnFlow repository ignore rules
#
# Covers local, generated, and private data only. See the "Local and Generated
# Data" section of docs/development/folder-structure.md.
#
# Deliberately NOT ignored: docs/, .claude/agents/, backend/requirements.txt,
# .env.example
# ---------------------------------------------------------------------------

# --- Python -----------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Node.js and Next.js ----------------------------------------------------
node_modules/
.next/
out/
.turbo/
next-env.d.ts
*.tsbuildinfo
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment and secrets ------------------------------------------------
.env
.env.*
*.pem
*.key
secrets/
!.env.example

# --- IDE and local user settings --------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.claude/settings.json
.claude/settings.local.json

# --- Learner data and runtime storage ---------------------------------------
# Learner PDFs, notes, attachments and screenshots are private local data.
# Rooted paths only: backend/app/infrastructure/storage/ is source code.
/storage/
/uploads/
/data/
/resource_storage/
/backend/storage/
/backend/uploads/

# --- Vector store -----------------------------------------------------------
/chroma/
/chroma_data/
.chroma/

# --- Database and container volume data -------------------------------------
/postgres_data/
/pgdata/
/volumes/
*.sqlite
*.sqlite3
*.db

# --- Logs -------------------------------------------------------------------
logs/
*.log

# --- OS-generated -----------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
